{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "connectionDB": "Data Source=(localdb)\\MSSQLLocalDB;Database=db_user;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AllowedHosts": "*",

  // URL base de PokéAPI. Se inyecta en el HttpClient nombrado "PokeApi".
  "PokeApi": {
    "BaseUrl": "https://pokeapi.co/api/v2/"
  },

  // Orígenes permitidos para CORS en producción.
  // Agrega aquí la URL donde esté desplegado el frontend React.
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  }
}
