{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // En desarrollo se permiten los puertos locales de Vite (5173) y CRA (3000).
  // Estos valores sobreescriben los de appsettings.json cuando el entorno es Development.
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "https://localhost:5173",
      "https://localhost:3000"
    ]
  }
}
